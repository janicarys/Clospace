<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/light_blue">

    <!-- Header -->
    <TextView
        android:id="@+id/tvSettingsTitle"
        style="@style/ClospaceTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:text="Settings"
        android:textSize="32sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvSquiggle"
        style="@style/ClospaceSquiggle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/tvSettingsTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Settings Options -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="48dp"
        android:orientation="vertical"
        android:paddingHorizontal="40dp"
        app:layout_constraintTop_toBottomOf="@id/tvSquiggle"
        app:layout_constraintBottom_toTopOf="@id/layoutBottomNav">

        <!-- Notifications Row -->
        <!-- Commented out for now; notifications feature not yet defined.
        <LinearLayout
            style="@style/ClospaceSettingsCard">

            <TextView
                style="@style/ClospaceSettingLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/notifications"/>

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switchNotifications"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

        </LinearLayout>
        -->

        <!-- Account Row -->
        <LinearLayout
            android:id="@+id/layoutAccount"
            style="@style/ClospaceSettingsCard"
            android:clickable="true"
            android:focusable="true">

            <TextView
                style="@style/ClospaceSettingLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/account"/>

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_chevron_right"/>

        </LinearLayout>

        <!-- Manage Tags Row -->
        <LinearLayout
            android:id="@+id/layoutManageTags"
            style="@style/ClospaceSettingsCard"
            android:clickable="true"
            android:focusable="true">

            <TextView
                style="@style/ClospaceSettingLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/manage_tags"/>

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_chevron_right"/>

        </LinearLayout>

        <!-- About Row -->
        <LinearLayout
            android:id="@+id/layoutAbout"
            style="@style/ClospaceSettingsCard"
            android:clickable="true"
            android:focusable="true">

            <TextView
                style="@style/ClospaceSettingLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/about"/>

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_chevron_right" />

        </LinearLayout>

        <!-- Contact Support Row -->
        <LinearLayout
            android:id="@+id/layoutSupport"
            style="@style/ClospaceSettingsCard"
            android:clickable="true"
            android:focusable="true">

            <TextView
                style="@style/ClospaceSettingLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/contact_support"/>

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_chevron_right"/>

        </LinearLayout>

    </LinearLayout>

    <!-- Bottom Navigation Bar -->
    <LinearLayout
        android:id="@+id/layoutBottomNav"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:orientation="horizontal"
        android:background="@android:color/white"
        android:paddingTop="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Closet (Inactive State) -->
        <LinearLayout
            android:id="@+id/navCloset"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">
            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_closet_outline" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Closet"
                android:textSize="14sp"
                android:textColor="@android:color/black"
                android:fontFamily="@font/rokkitt_regular"/>
        </LinearLayout>

        <!-- Outfit (Inactive State) -->
        <LinearLayout
            android:id="@+id/navOutfit"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">
            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_hanger" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Outfit"
                android:textSize="14sp"
                android:textColor="@android:color/black"
                android:fontFamily="@font/rokkitt_regular"/>
        </LinearLayout>

        <!-- Calendar (Inactive State) -->
        <LinearLayout
            android:id="@+id/navCalendar"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">
            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_calendar" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Calendar"
                android:textSize="14sp"
                android:textColor="@android:color/black"
                android:fontFamily="@font/rokkitt_regular"/>
        </LinearLayout>

        <!-- Settings (Active State) -->
        <LinearLayout
            android:id="@+id/navSettings"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">
            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_settings" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Settings"
                android:textSize="14sp"
                android:textColor="@android:color/black"
                android:fontFamily="@font/rokkitt_regular"/>
            <!-- Lavender underline shifted here -->
            <View
                android:layout_width="40dp"
                android:layout_height="4dp"
                android:layout_marginTop="4dp"
                android:background="@color/lavender"/>
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>