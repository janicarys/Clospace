<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/light_blue">

    <!-- Header -->
    <TextView
        android:id="@+id/tvWelcome"
        style="@style/ClospaceTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:text="Welcome to your closet!"
        android:textSize="32sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvSquiggle"
        style="@style/ClospaceSquiggle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/tvWelcome"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/searchLayout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="28dp"
        android:layout_marginTop="24dp"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"

        app:layout_constraintTop_toBottomOf="@id/tvSquiggle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"

        app:startIconDrawable="@drawable/ic_search"
        app:boxCornerRadiusTopStart="20dp"
        app:boxCornerRadiusTopEnd="20dp"
        app:boxCornerRadiusBottomStart="20dp"
        app:boxCornerRadiusBottomEnd="20dp">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etSearch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/search_closet"/>

    </com.google.android.material.textfield.TextInputLayout>

    <!-- Bottom Navigation Bar (Custom implementation for exact visual match) -->
    <LinearLayout
        android:id="@+id/layoutBottomNav"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:orientation="horizontal"
        android:background="@android:color/white"
        android:paddingTop="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Closet (Active State) -->
        <LinearLayout
            android:id="@+id/navCloset"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">
            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_closet_outline" /> <!-- Placeholder drawable -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Closet"
                android:textSize="14sp"
                android:textColor="@android:color/black"
                android:fontFamily="@font/rokkitt_regular"/>
            <View
                android:layout_width="40dp"
                android:layout_height="4dp"
                android:layout_marginTop="4dp"
                android:background="@color/lavender"/>
        </LinearLayout>

        <!-- Outfit (Inactive State) -->
        <LinearLayout
            android:id="@+id/navOutfit"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">
            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_hanger" /> <!-- Placeholder drawable -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Outfit"
                android:textSize="14sp"
                android:textColor="@android:color/black"
                android:fontFamily="@font/rokkitt_regular"/>
            <!-- No lavender underline here -->
        </LinearLayout>

        <!-- Calendar (Inactive State) -->
        <LinearLayout
            android:id="@+id/navCalendar"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">
            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_calendar" /> <!-- Placeholder drawable -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Calendar"
                android:textSize="14sp"
                android:textColor="@android:color/black"
                android:fontFamily="@font/rokkitt_regular"/>
        </LinearLayout>

        <!-- Settings (Inactive State) -->
        <LinearLayout
            android:id="@+id/navSettings"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">
            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_settings" /> <!-- Placeholder drawable -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Settings"
                android:textSize="14sp"
                android:textColor="@android:color/black"
                android:fontFamily="@font/rokkitt_regular"/>
        </LinearLayout>
    </LinearLayout>

    <!-- Main Scrollable Content -->
    <!-- Constrained between the top header and the bottom nav -->
    <!-- Main Scrollable Content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="20dp"

        app:layout_constraintTop_toBottomOf="@id/searchLayout"
        app:layout_constraintBottom_toTopOf="@id/layoutBottomNav"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="28dp">

            <!-- ================= TOPS ================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:layout_marginBottom="24dp"
                android:background="@drawable/category_card"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    style="@style/ClospaceLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/tops"/>

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginTop="12dp"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/horizontalTops"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:id="@+id/placeholderTops"
                            style="@style/ClospacePlaceholderCard"
                            android:background="@drawable/garment_placeholder">

                            <ImageView
                                style="@style/ClospacePlaceholderIcon"
                                android:src="@drawable/ic_add"
                                android:contentDescription="@string/add_top" />

                            <TextView
                                style="@style/ClospacePlaceholderText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/add_top"/>

                        </LinearLayout>

                    </LinearLayout>

                </HorizontalScrollView>

            </LinearLayout>

            <!-- ================= BOTTOMS ================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:layout_marginBottom="24dp"
                android:background="@drawable/category_card"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    style="@style/ClospaceLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/bottoms"/>

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginTop="12dp"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/horizontalBottoms"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:id="@+id/placeholderBottoms"
                            style="@style/ClospacePlaceholderCard"
                            android:background="@drawable/garment_placeholder">

                            <ImageView
                                style="@style/ClospacePlaceholderIcon"
                                android:src="@drawable/ic_add"
                                android:contentDescription="@string/add_bottom" />

                            <TextView
                                style="@style/ClospacePlaceholderText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/add_bottom"/>

                        </LinearLayout>

                    </LinearLayout>

                </HorizontalScrollView>

            </LinearLayout>

            <!-- ================= FOOTWEAR ================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:layout_marginBottom="24dp"
                android:background="@drawable/category_card"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    style="@style/ClospaceLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/footwear"/>

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginTop="12dp"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/horizontalFootwear"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:id="@+id/placeholderFootwear"
                            style="@style/ClospacePlaceholderCard"
                            android:background="@drawable/garment_placeholder">

                            <ImageView
                                style="@style/ClospacePlaceholderIcon"
                                android:src="@drawable/ic_add"
                                android:contentDescription="@string/add_footwear" />

                            <TextView
                                style="@style/ClospacePlaceholderText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/add_footwear"/>

                        </LinearLayout>

                    </LinearLayout>

                </HorizontalScrollView>

            </LinearLayout>

            <!-- ================= ACCESSORIES ================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:layout_marginBottom="80dp"
                android:background="@drawable/category_card"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    style="@style/ClospaceLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/accessories"/>

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginTop="12dp"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/horizontalAccessories"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:id="@+id/placeholderAccessories"
                            style="@style/ClospacePlaceholderCard"
                            android:background="@drawable/garment_placeholder">

                            <ImageView
                                style="@style/ClospacePlaceholderIcon"
                                android:src="@drawable/ic_add"
                                android:contentDescription="@string/add_accessory" />

                            <TextView
                                style="@style/ClospacePlaceholderText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/add_accessory"/>

                        </LinearLayout>

                    </LinearLayout>

                </HorizontalScrollView>

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

    <!-- Floating Action Button (+) -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabAdd"
        android:layout_width="56dp"
        android:layout_height="56dp"

        android:layout_marginEnd="28dp"
        android:layout_marginBottom="36dp"

        android:src="@drawable/ic_add"
        android:contentDescription="@string/add_item"

        app:backgroundTint="@color/violet"
        app:tint="@android:color/white"
        app:elevation="8dp"

        app:layout_constraintBottom_toTopOf="@id/layoutBottomNav"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>