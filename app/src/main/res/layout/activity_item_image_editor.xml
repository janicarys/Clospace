<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/light_blue">

    <!-- Toolbar -->

    <ImageButton
        android:id="@+id/btnBack"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="24dp"
        android:padding="12dp"
        android:background="@android:color/transparent"
        android:src="@drawable/ic_arrow_back"
        android:contentDescription="@string/back"
        app:tint="@color/purple"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

    <TextView
        android:id="@+id/tvToolbarTitle"
        style="@style/ClospaceTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/image_editor_title"
        android:textSize="28sp"
        android:layout_marginStart="12dp"
        app:layout_constraintStart_toEndOf="@id/btnBack"
        app:layout_constraintTop_toTopOf="@id/btnBack"
        app:layout_constraintBottom_toBottomOf="@id/btnBack"/>

    <Button
        android:id="@+id/btnSave"
        style="@style/ClospacePrimaryButton"
        android:layout_width="112dp"
        android:layout_height="44dp"
        android:layout_marginEnd="16dp"
        android:text="@string/save"
        android:textSize="15sp"
        app:layout_constraintTop_toTopOf="@id/btnBack"
        app:layout_constraintBottom_toBottomOf="@id/btnBack"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Square preview -->

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardPreview"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="24dp"
        app:cardBackgroundColor="@color/calendar_card"
        app:cardCornerRadius="20dp"
        app:cardElevation="2dp"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintTop_toBottomOf="@id/btnBack"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/imgPreview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"
            android:padding="16dp"/>

    </com.google.android.material.card.MaterialCardView>

    <!-- Image controls -->

    <LinearLayout
        android:id="@+id/controlRow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageButton
            android:id="@+id/btnUndo"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginHorizontal="6dp"
            android:background="@drawable/back_circle_background"
            android:padding="13dp"
            android:src="@drawable/undo_24"
            android:contentDescription="@string/undo"
            app:tint="@color/purple"/>

        <ImageButton
            android:id="@+id/btnRotateLeft"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginHorizontal="6dp"
            android:background="@drawable/back_circle_background"
            android:padding="13dp"
            android:src="@drawable/rotate_left_24"
            android:contentDescription="@string/rotate_left"
            app:tint="@color/purple"/>

        <ImageButton
            android:id="@+id/btnZoomOut"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginHorizontal="6dp"
            android:background="@drawable/back_circle_background"
            android:padding="13dp"
            android:src="@drawable/ic_zoom_out"
            android:contentDescription="@string/zoom_out_btn"
            app:tint="@color/purple"/>

        <ImageButton
            android:id="@+id/btnZoomIn"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginHorizontal="6dp"
            android:background="@drawable/back_circle_background"
            android:padding="13dp"
            android:src="@drawable/ic_zoom_in"
            android:contentDescription="@string/zoom_in_btn"
            app:tint="@color/purple"/>

        <ImageButton
            android:id="@+id/btnRotateRight"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginHorizontal="6dp"
            android:background="@drawable/back_circle_background"
            android:padding="13dp"
            android:src="@drawable/rotate_right_24"
            android:contentDescription="@string/rotate_right"
            app:tint="@color/purple"/>

        <ImageButton
            android:id="@+id/btnReset"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginHorizontal="6dp"
            android:background="@drawable/back_circle_background"
            android:padding="13dp"
            android:src="@drawable/ic_refresh"
            android:contentDescription="@string/reset_image"
            app:tint="@color/purple"/>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>