<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/light_blue">

    <TextView
        android:id="@+id/tvLetsGetStarted"
        style="@style/ClospaceTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="48dp"

        android:text="@string/signup_title"

        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvSubtitle"
        style="@style/ClospaceSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/signup_subtitle"

        android:layout_marginTop="8dp"

        app:layout_constraintTop_toBottomOf="@id/tvLetsGetStarted"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <LinearLayout
        android:id="@+id/layoutSignUpForm"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"

        android:layout_marginStart="70dp"
        android:layout_marginEnd="70dp"
        android:layout_marginTop="36dp"

        app:layout_constraintTop_toBottomOf="@id/tvSubtitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Username Field -->
        <TextView
            android:id="@+id/tvUsername"
            style="@style/ClospaceLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/login_username"
            android:labelFor="@id/etUsername"/>

        <EditText
            android:id="@+id/etUsername"
            style="@style/ClospaceEditText"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="2dp"
            android:background="@drawable/edittext_background"
            android:paddingHorizontal="12dp"
            android:hint="@string/hint_username"
            android:textColorHint="@color/brown"
            android:inputType="text"
            android:autofillHints="username"
            android:imeOptions="actionNext"
            />

        <!-- Display Name Field -->
        <TextView
            android:id="@+id/tvDisplayName"
            style="@style/ClospaceLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/signup_display_name"
            android:labelFor="@id/etDisplayName"/>

        <EditText
            android:id="@+id/etDisplayName"
            style="@style/ClospaceEditText"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="2dp"
            android:background="@drawable/edittext_background"
            android:paddingHorizontal="12dp"
            android:hint="@string/hint_display_name"
            android:textColorHint="@color/brown"
            android:inputType="textPersonName"
            android:autofillHints="name"
            android:imeOptions="actionNext" />

        <!-- Password Field -->
        <TextView
            android:id="@+id/tvPassword"
            style="@style/ClospaceLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/login_password"
            android:labelFor="@id/etPassword"/>

        <EditText
            android:id="@+id/etPassword"
            style="@style/ClospaceEditText"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="2dp"
            android:background="@drawable/edittext_background"
            android:paddingHorizontal="12dp"
            android:hint="@string/hint_password"
            android:textColorHint="@color/brown"
            android:inputType="textPassword"
            android:autofillHints="password"
            android:imeOptions="actionDone"
            />



        <!-- Avatar Selection -->
        <TextView
            android:id="@+id/tvChooseAvatar"
            style="@style/ClospaceLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:layout_marginTop="32dp"

            android:text="@string/signup_choose_avatar"/>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="16dp">

            <ImageButton
                android:id="@+id/ivAvatarMale"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_marginEnd="16dp"
                android:background="@android:color/transparent"
                android:padding="3dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_avatar_male"
                android:contentDescription="@string/avatar_male"/>

            <ImageButton
                android:id="@+id/ivAvatarFemale"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_marginStart="16dp"
                android:background="@android:color/transparent"
                android:padding="3dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_avatar_female"
                android:contentDescription="@string/avatar_female"/>
        </LinearLayout>

    </LinearLayout>

    <Button
        android:id="@+id/btnSubmit"
        style="@style/ClospaceButtonText"
        android:layout_width="220dp"
        android:layout_height="60dp"
        android:background="@drawable/button_background"
        android:text="@string/signup_button"
        android:textAllCaps="true"

        android:layout_marginTop="32dp"
        android:paddingHorizontal="18dp"

        app:layout_constraintTop_toBottomOf="@id/layoutSignUpForm"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <LinearLayout
        android:id="@+id/layoutSignInRow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"

        android:layout_marginBottom="32dp"

        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            style="@style/ClospaceSmallText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/signup_have_account"/>

        <TextView
            android:id="@+id/tvSignIn"
            style="@style/ClospaceSmallLink"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/signup_sign_in"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>


</androidx.constraintlayout.widget.ConstraintLayout>