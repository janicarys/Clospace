<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/light_blue">

    <TextView
        android:id="@+id/tvClospace"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:textSize="60sp"
        android:textColor="@color/purple"
        android:fontFamily="@font/rokkitt_medium"
        android:layout_marginTop="150dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/tvSquiggle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:textSize="34sp"
        android:textColor="@color/lavender"
        android:fontFamily="@font/redactedscript_regular"
        android:layout_marginTop="-10dp"
        app:layout_constraintTop_toBottomOf="@id/tvClospace"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <LinearLayout
        android:id="@+id/layoutLoginForm"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginStart="70dp"
        android:layout_marginEnd="70dp"
        android:layout_marginTop="40dp"
        app:layout_constraintTop_toBottomOf="@id/tvSquiggle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tvUsername"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Email"
            android:textSize="28sp"
            android:textColor="@color/purple"
            android:fontFamily="@font/rokkitt_regular"
            android:labelFor="@id/etUsername"/>

        <EditText
            android:id="@+id/etUsername"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/edittext_background"
            android:paddingHorizontal="12dp"
            android:hint="Enter email"
            android:textColorHint="@color/brown"
            android:inputType="text"
            android:autofillHints="emailAddress"
            android:imeOptions="actionNext"/>

        <TextView
            android:id="@+id/tvPassword"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="Password"
            android:textSize="28sp"
            android:textColor="@color/purple"
            android:fontFamily="@font/rokkitt_regular"
            android:labelFor="@id/etPassword"/>

        <FrameLayout
            android:id="@+id/layoutPassword"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="6dp">

            <EditText
                android:id="@+id/etPassword"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/edittext_background"
                android:paddingHorizontal="12dp"
                android:paddingEnd="48dp"
                android:hint="Enter password"
                android:textColorHint="@color/brown"
                android:inputType="textPassword"
                android:autofillHints="password"
                android:imeOptions="actionDone"/>

            <ImageButton
                android:id="@+id/btnTogglePassword"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="end|center_vertical"
                android:layout_marginEnd="6dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Toggle password visibility"
                android:src="@drawable/ic_visibility"/>

        </FrameLayout>

    </LinearLayout>

    <Button
        android:id="@+id/btnLogin"
        android:layout_width="160dp"
        android:layout_height="60dp"
        android:layout_marginTop="60dp"
        android:background="@drawable/button_background"
        android:text="LOG IN"
        android:textAllCaps="true"
        android:textColor="@android:color/white"
        android:textSize="20sp"
        android:fontFamily="@font/rokkitt_bold"
        app:layout_constraintTop_toBottomOf="@id/layoutLoginForm"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <LinearLayout
        android:id="@+id/layoutSignUpRow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="32dp"
        app:layout_constraintTop_toBottomOf="@id/btnLogin"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Don't have an account? "
            android:textSize="14sp"
            android:textColor="@color/brown"
            android:fontFamily="@font/rokkitt_regular"/>

        <TextView
            android:id="@+id/tvSignUp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sign Up"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/purple"
            android:fontFamily="@font/rokkitt_bold"/>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>