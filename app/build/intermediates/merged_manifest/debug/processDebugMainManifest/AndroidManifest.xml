            android:parentActivityName="com.mobdeve.s15.reyes.janicamegan.clospace.SelectGarmentsActivity" />
        <activity
            android:name="com.mobdeve.s15.reyes.janicamegan.clospace.OutfitDetailsActivity"
            android:exported="false"
            android:parentActivityName="com.mobdeve.s15.reyes.janicamegan.clospace.OutfitCanvasActivity" />
        <activity
            android:name="com.mobdeve.s15.reyes.janicamegan.clospace.OutfitDetailActivity"
            android:exported="false"
            android:parentActivityName="com.mobdeve.s15.reyes.janicamegan.clospace.MainActivity" />
        <activity
            android:name="com.mobdeve.s15.reyes.janicamegan.clospace.GarmentDetailActivity"
            android:exported="false"
            android:parentActivityName="com.mobdeve.s15.reyes.janicamegan.clospace.MainActivity" />

        <!-- Secondary Pages -->
        <activity
            android:name="com.mobdeve.s15.reyes.janicamegan.clospace.AboutActivity"
            android:exported="false"
            android:parentActivityName="com.mobdeve.s15.reyes.janicamegan.clospace.MainActivity" />
        <activity
            android:name="com.mobdeve.s15.reyes.janicamegan.clospace.SupportActivity"
            android:exported="false"
            android:parentActivityName="com.mobdeve.s15.reyes.janicamegan.clospace.MainActivity" />

