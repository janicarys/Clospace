    <style name="Base.Theme.Clospace" parent="Theme.Material3.DayNight.NoActionBar">
        
        
    </style>
    <style name="ClospaceBody">
        <item name="android:fontFamily">@font/rokkitt_regular</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">@color/brown</item>
        <item name="android:lineSpacingExtra">6dp</item>
    </style>
    <style name="ClospaceCaption">
        <item name="android:fontFamily">@font/rokkitt_regular</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/brown</item>
    </style>
    <style name="ClospaceEditText">

        <item name="android:fontFamily">@font/rokkitt_regular</item>

        <item name="android:textSize">18sp</item>

        <item name="android:textColor">@color/violet</item>
        <item name="android:textColorHint">@color/brown</item>

        <item name="android:background">@drawable/edittext_background</item>

        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>

    </style>
    <style name="ClospaceLabel">
        <item name="android:fontFamily">@font/rokkitt_regular</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textColor">@color/violet</item>
    </style>
    <style name="ClospaceLink">
        <item name="android:fontFamily">@font/rokkitt_bold</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/violet</item>
    </style>
    <style name="ClospacePlaceholderCard">
        <item name="android:layout_width">110dp</item>
        <item name="android:layout_height">110dp</item>
        <item name="android:layout_marginEnd">16dp</item>
        <item name="android:background">@drawable/garment_placeholder</item>
        <item name="android:orientation">vertical</item>
        <item name="android:gravity">center</item>
    </style>
    <style name="ClospacePlaceholderIcon">
        <item name="android:layout_width">36dp</item>
        <item name="android:layout_height">36dp</item>
        <item name="android:tint">@android:color/white</item>
    </style>
    <style name="ClospacePlaceholderText">
        <item name="android:textColor">@android:color/white</item>
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">@font/rokkitt_medium</item>
        <item name="android:layout_marginTop">12dp</item>
    </style>
    <style name="ClospacePrimaryButton">

        <item name="android:layout_width">240dp</item>
        <item name="android:layout_height">56dp</item>

        <item name="android:background">@drawable/button_background</item>

        <item name="android:textAllCaps">true</item>

        <item name="android:fontFamily">@font/rokkitt_bold</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">@android:color/white</item>

    </style>
    <style name="ClospaceSettingLabel">
        <item name="android:textSize">22sp</item>
        <item name="android:textColor">@color/violet</item>
        <item name="android:fontFamily">@font/rokkitt_regular</item>
    </style>
    <style name="ClospaceSettingsCard">

        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">64dp</item>

        <item name="android:background">@drawable/settings_card</item>

        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>

        <item name="android:gravity">center_vertical</item>

        <item name="android:orientation">horizontal</item>

        <item name="android:layout_marginBottom">16dp</item>

    </style>
    <style name="ClospaceSquiggle">
        <item name="android:fontFamily">@font/redactedscript_regular</item>
        <item name="android:textSize">34sp</item>
        <item name="android:textColor">@color/lavender</item>
    </style>
    <style name="ClospaceSubtitle">
        <item name="android:fontFamily">@font/rokkitt_regular</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/brown</item>
    </style>
    <style name="ClospaceTitle">
        <item name="android:fontFamily">@font/rokkitt_bold</item>
        <item name="android:textSize">42sp</item>
        <item name="android:textColor">@color/violet</item>
    </style>
    <style name="Theme.Clospace" parent="Base.Theme.Clospace"/>
